FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0t64 libsm6 libxext6 libxrender-dev libgomp1 wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY face_vector_service/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY face_vector_service/ ./
RUN mkdir -p models

EXPOSE 5000
CMD ["python", "face_vector_service.py"]
