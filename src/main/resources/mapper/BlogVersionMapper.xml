<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.revy.talkblogback.mapper.BlogVersionMapper">

    <resultMap id="BlogVersionResultMap" type="com.revy.talkblogback.pojo.BlogVersion">
        <id column="id" property="id"/>
        <result column="blog_id" property="blogId"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="category" property="category"/>
        <result column="series_id" property="seriesId"/>
        <result column="version" property="version"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.revy.talkblogback.pojo.BlogVersion">
        INSERT INTO blog_versions (blog_id, title, content, category, series_id, version, created_at)
        VALUES (#{blogId}, #{title}, #{content}, #{category}, #{seriesId}, #{version}, NOW())
    </insert>

    <select id="findByBlogId" resultMap="BlogVersionResultMap">
        SELECT * FROM blog_versions
        WHERE blog_id = #{blogId}
        ORDER BY version DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByBlogId" resultType="long">
        SELECT COUNT(1) FROM blog_versions WHERE blog_id = #{blogId}
    </select>

    <select id="findLatestByBlogId" resultMap="BlogVersionResultMap">
        SELECT * FROM blog_versions
        WHERE blog_id = #{blogId}
        ORDER BY version DESC
        LIMIT 1
    </select>

</mapper>
